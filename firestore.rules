rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // تقدّم كل شخص: يشوفه ويعدّله صاحبه بس
    match /users/{uid}/progress/{gameId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.size() < 50;
    }
    // المتصدرين: كل المسجّلين يشوفونها، وكل شخص يكتب نتيجته هو بس
    match /leaderboards/{gameId}/scores/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['name', 'photo', 'score', 'updatedAt'])
                   && request.resource.data.score is number
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 20
                   && request.resource.data.photo is string
                   && request.resource.data.photo.size() <= 500;
    }
  }
}
